root = true

# One line length for the whole repo, set here and nowhere else: 140. Editors
# (IntelliJ / Android Studio, Xcode, VS Code) read max_line_length for their
# margin guide and hard wrap; ktlint enforces it and `mise run format` wraps
# signatures and argument lists that pass it. detekt's MaxLineLength is off so
# nothing holds a second copy of the number (LESSONS D-003).
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 140

[*.{yml,yaml,json,json5}]
indent_size = 2

# Xcode writes plists with tabs.
[*.plist]
indent_style = tab

# Windows needs CRLF in the Gradle wrapper script.
[*.bat]
end_of_line = crlf

[*.{kt,kts}]
# ktlint_official forces a multiline class header at >= 1 constructor parameter
# and a multiline function signature at >= 2 parameters, regardless of length.
# Unset both so a declaration wraps only when it passes 140.
ktlint_class_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = unset
ktlint_function_signature_rule_force_multiline_when_parameter_count_greater_or_equal_than = unset
